    "version": "0.2.0",
    
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": " -v record hi.scenario testapp:main",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/computer_code/api/PyQtTester/"
            }
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "computer_code/api/index.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/computer_code/venv/bin/python3",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/computer_code"
            }
        }
    ]
    
}